<section class="articleBody" data-frontpage-filter-vue v-cloak
    data-search-placeholder="{{ 'Search'|t }}"
    data-ai-search-placeholder="{{ 'Search using AI...'|t }}"
    data-ai-search-label="{{ 'Enable AI search'|t }}"
    data-ai-search-error="{{ 'AI search is temporarily unavailable. Please try again.'|t }}"
    data-ai-search-no-results="{{ 'No answer found for that question.'|t }}"
>
    <div class="articleList__search">
        <div class="articleList__search-form">
            <input type="search" aria-label="search" :placeholder="searchPlaceholder" v-model="searchQuery" @keyup.enter="askAi"/>
            <div class="articleList__search-toggle mobile--hidden">
                <span class="articleList__search-toggle-label">{{ 'AI-search'|t }}</span>
                <button type="button"
                    class="lightswitch"
                    :class="{ 'is-on': aiSearchEnabled }"
                    role="switch"
                    :aria-checked="aiSearchEnabled.toString()"
                    :aria-label="aiSearchLabel"
                    @click="aiSearchEnabled = !aiSearchEnabled"
                >
                    <span class="lightswitch__rail"><span class="lightswitch__handle"></span></span>
                </button>
            </div>
        </div>
        <div class="articleList__search-toggle articleList__search-toggle--mobile desktop--hidden">
            <button type="button"
                class="lightswitch"
                :class="{ 'is-on': aiSearchEnabled }"
                role="switch"
                :aria-checked="aiSearchEnabled.toString()"
                :aria-label="aiSearchLabel"
                @click="aiSearchEnabled = !aiSearchEnabled"
            >
                <span class="lightswitch__rail"><span class="lightswitch__handle"></span></span>
            </button>
            <span class="articleList__search-toggle-label">{{ 'AI-search'|t }}</span>
        </div>
        <button v-if="!aiSearchEnabled" @click="showFilters = !showFilters"
            class="articleList__filters-button desktop--hidden"
            :class="showFilters ? 'active' : ''"
        >Filter</button>
        <div v-if="!aiSearchEnabled" class="articleList__filters-wrapper"
            :class="showFilters ? 'active' : ''">
            <div class="articleList__filters">
                <article-filter v-for="subject in articleSubjects" :key="subject" 
                    :name="subject"
                    :subject="subject"
                    :selected="selectedSubjects.includes(subject)"
                    @change="updateSubjectFilters"
                ></article-filter>
            </div>
            <div class="articleList__filters">
                <article-filter v-for="language in articleLanguages" :key="language" 
                    :name="language"
                    :language="language"
                    :selected="selectedLanguages.includes(language)"
                    @change="updateLanguageFilters"
                ></article-filter>
            </div>
        </div>
    </div>

    <div class="articleList__aiResult" v-if="aiSearchEnabled && (askLoading || askSubmitted)">
        <div class="articleList__aiResult-header">{{ 'AI Answer'|t }}</div>
        <div class="articleList__aiResult-body" ref="aiResultBody" :style="{ minHeight: askResultMinHeight }">
            <section v-if="askLoading">
                <div class="thmScoreboard__loading">
                    <div class="thmScoreboard__loading-spinner"></div>
                </div>
            </section>
            <template v-else-if="!askAnswerPending">
                <p v-if="askError" class="articleList__aiResult-error">[[askError]]</p>
                <div v-else-if="askAnswer" ref="aiAnswerEl" class="articleList__aiResult-answer" :style="{ maxHeight: askAnswerMaxHeight }" v-html="renderedAskAnswer"></div>
                <p v-else class="articleList__aiResult-error">[[aiSearchNoResultsMessage]]</p>
            </template>
        </div>
    </div>

    <div class="articleList__container" v-if="aiSearchEnabled && askMatchedArticles.length">
        <article-item
            v-for="(article, index) in askMatchedArticles"
            :key="article.uuid"
            :article="article"
            class="articleList__aiResult-article"
            :class="{ 'is-revealed': askArticlesRevealed }"
            :style="{ transitionDelay: (index * 150) + 'ms' }"
        />
    </div>

    <div v-if="!aiSearchEnabled">
        <section v-if="!loaded">
            <div class="thmScoreboard__loading">
                <div class="thmScoreboard__loading-spinner"></div>
            </div>
        </section>

        <section>
            <div class="articleList__container" v-if="articles">
                <article-item v-for="article in filteredArticles" :key="article.id" :article="article" />
            </div>
        </section>
    </div>
</section>
