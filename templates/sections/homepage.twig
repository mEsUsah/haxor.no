<section class="articleBody" data-frontpage-filter-vue
    data-search-placeholder="{{ 'Search'|t }}"
    data-ai-search-placeholder="{{ 'Search using AI...'|t }}"
    data-ai-search-label="{{ 'Enable AI search'|t }}"
>
    <div class="articleList__search">
        <div class="articleList__search-form">
            <input type="search" aria-label="search" :placeholder="searchPlaceholder" v-model="searchQuery"/>
            <div class="articleList__search-toggle mobile--hidden">
                <span class="articleList__search-toggle-label">{{ 'AI-search'|t }}</span>
                <button type="button"
                    class="lightswitch"
                    :class="{ 'is-on': aiSearchEnabled }"
                    role="switch"
                    :aria-checked="aiSearchEnabled.toString()"
                    :aria-label="aiSearchLabel"
                    @click="aiSearchEnabled = !aiSearchEnabled"
                >
                    <span class="lightswitch__rail"><span class="lightswitch__handle"></span></span>
                </button>
            </div>
        </div>
        <div class="articleList__search-toggle articleList__search-toggle--mobile desktop--hidden">
            <button type="button"
                class="lightswitch"
                :class="{ 'is-on': aiSearchEnabled }"
                role="switch"
                :aria-checked="aiSearchEnabled.toString()"
                :aria-label="aiSearchLabel"
                @click="aiSearchEnabled = !aiSearchEnabled"
            >
                <span class="lightswitch__rail"><span class="lightswitch__handle"></span></span>
            </button>
            <span class="articleList__search-toggle-label">{{ 'AI-search'|t }}</span>
        </div>
        <button v-if="!aiSearchEnabled" @click="showFilters = !showFilters"
            class="articleList__filters-button desktop--hidden"
            :class="showFilters ? 'active' : ''"
        >Filter</button>
        <div v-if="!aiSearchEnabled" class="articleList__filters-wrapper"
            :class="showFilters ? 'active' : ''">
            <div class="articleList__filters">
                <article-filter v-for="subject in articleSubjects" :key="subject" 
                    :name="subject"
                    :subject="subject"
                    :selected="selectedSubjects.includes(subject)"
                    @change="updateSubjectFilters"
                ></article-filter>
            </div>
            <div class="articleList__filters">
                <article-filter v-for="language in articleLanguages" :key="language" 
                    :name="language"
                    :language="language"
                    :selected="selectedLanguages.includes(language)"
                    @change="updateLanguageFilters"
                ></article-filter>
            </div>
        </div>
    </div>

    <div >
        <section v-if="!loaded">
            <div class="thmScoreboard__loading">
                <div class="thmScoreboard__loading-spinner"></div>
            </div>
        </section>
        
        <section>
            <div class="articleList__container" v-if="articles">
                <article-item v-for="article in filteredArticles" :key="article.id" :article="article" />
            </div>
        </section>
    </div>
</section>
